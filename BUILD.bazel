load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("//:defs.bzl", "delay_line")

package(
    default_visibility = ["//visibility:private"],
)

bzl_library(
    name = "providers_bzl",
    srcs = ["providers.bzl"],
    visibility = ["//visibility:private"],
)

bzl_library(
    name = "defs_bzl",
    srcs = ["defs.bzl"],
    visibility = ["//visibility:public"],
    deps = [":providers_bzl"],
)

delay_line(
    name = "fast_build",
    params_file = "//config:params_file",
)